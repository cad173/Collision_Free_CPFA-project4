<?xml version="1.0" ?>
<argos-configuration>

  <!-- ===================== -->
  <!-- Framework -->
  <!-- ===================== -->
  <framework>
    <system threads="0"/>
    <experiment length="6000" random_seed="0" ticks_per_second="32"/>
  </framework>

  <controllers>

  <!-- CPFA -->
  <CPFA_controller id="CPFA"
              library="build/source/CPFA/libCPFA_controller"
              label="CPFA_controller">

    <actuators>
      <differential_steering implementation="default"/>
      <leds implementation="default" medium="leds"/>
    </actuators>

    <sensors>
      <footbot_proximity implementation="default" show_rays="true"/>
      <positioning implementation="default"/>
      <footbot_motor_ground implementation="rot_z_only"/>
    </sensors>

    <params>
      <settings
        DestinationNoiseStdev="0.0"
        FoodDistanceTolerance="0.13"
        NestAngleTolerance="0.1"
        PositionNoiseStdev="0.00"
        ResultsDirectoryPath="results/"
        RobotForwardSpeed="16.0"
        RobotRotationSpeed="8.0"
        SearchStepSize="0.08"
        TargetAngleTolerance="0.1"
        TargetDistanceTolerance="0.05"/>
    </params>

  </CPFA_controller>

  <!-- ADVERSARY -->
  <ACPFA_controller id="ACPFA_controller"
              library="build/source/CPFA/libACPFA_controller"
              label="ACPFA_controller">

    <actuators>
      <differential_steering implementation="default"/>
      <leds implementation="default" medium="leds"/>
    </actuators>

    <sensors>
      <footbot_proximity implementation="default" show_rays="true"/>
      <positioning implementation="default"/>
    </sensors>

    <params>
      <settings
        DestinationNoiseStdev="0.0"
        FoodDistanceTolerance="0.13"
        RobotForwardSpeed="16.0"
        RobotRotationSpeed="8.0"
        SearchStepSize="0.08"
        TargetDistanceTolerance="0.05"/>
    </params>

  </ACPFA_controller>

</controllers>

  <!-- ===================== -->
  <!-- Loop Functions -->
  <!-- ===================== -->
  <loop_functions label="CPFA_loop_functions"
                   library="build/source/CPFA/libCPFA_loop_functions">

    <CPFA
      PrintFinalScore="1"
      ProbabilityOfReturningToNest="0.0147598869881"
      ProbabilityOfSwitchingToSearching="0.723128706375"
      RateOfInformedSearchDecay="0.205799848158"
      RateOfLayingPheromone="14.7027566005"
      RateOfPheromoneDecay="0.0245057227138"
      RateOfSiteFidelity="14.1514206414"
      UninformedSearchVariation="2.81939731297"/>

    <settings
      ClusterWidthX="8"
      ClusterWidthY="8"
      DrawDensityRate="4"
      DrawIDs="1"
      DrawTargetRays="0"
      DrawTrails="0"
      FoodDistribution="0"
      FoodItemCount="256"
      FoodRadius="0.05"
      MaxSimCounter="1"
      MaxSimTimeInSeconds="1800"
      NestElevation="0.001"
      NestPosition="0,0"
      NestRadius="0.5"
      NumberOfClusters="4"
      OutputData="0"
      VariableFoodPlacement="0"/>

  </loop_functions>

  <!-- ===================== -->
  <!-- Arena -->
  <!-- ===================== -->
  <arena center="0,0,0.5" size="10.0, 10.0, 1">

    <floor id="floor" pixels_per_meter="10" source="loop_functions"/>

    <!-- Walls -->
    <box id="north" movable="false" size="10,0.05,0.5">
      <body position="0,5,0"/>
    </box>

    <box id="south" movable="false" size="10,0.05,0.5">
      <body position="0,-5,0"/>
    </box>

    <box id="east" movable="false" size="0.05,10,0.5">
      <body position="5,0,0"/>
    </box>

    <box id="west" movable="false" size="0.05,10,0.5">
      <body position="-5,0,0"/>
    </box>

    <!-- ===================== -->
    <!-- CPFA ROBOTS -->
    <!-- ===================== -->
    <distribute>
    <position center="1,1,0" distances="0.3,0.3,0" layout="6,3,1" method="grid"/>
    <orientation method="constant" values="0,0,0"/>

    <entity max_trials="100" quantity="18">
        <foot-bot id="cpfa">
          <controller config="CPFA"/>
        </foot-bot>
      </entity>
  </distribute>

<!-- ===================== -->
<!-- ADVERSARY ROBOTS -->
<!-- ===================== -->
    <distribute>
  <position center="-1,-1,0" distances="0.3,0.3,0" layout="3,2,1" method="grid"/>
  <orientation method="constant" values="0,0,0"/>

  <entity max_trials="100" quantity="6">
    <foot-bot id="adv">
      <controller config="ACPFA_controller"/>
    </foot-bot>
  </entity>
</distribute>


  </arena>

  <!-- ===================== -->
  <!-- Physics -->
  <!-- ===================== -->
  <physics_engines>
    <dynamics2d id="dyn2d"/>
  </physics_engines>

  <!-- ===================== -->
  <!-- Media -->
  <!-- ===================== -->
  <media>
    <led id="leds"/>
  </media>

  <!-- ===================== -->
  <!-- Visualization -->
  <!-- ===================== -->
  <visualization>
    <qt-opengl>
      <camera>
        <placement position="0,0,12"
                   look_at="0,0,0"
                   lens_focal_length="25"/>
      </camera>
      <user_functions label="CPFA_qt_user_functions"/>
    </qt-opengl>
  </visualization>

</argos-configuration>